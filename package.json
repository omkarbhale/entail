{
  "name": "entail",
  "version": "0.0.0",
  "description": "The owner's stand-in for product decisions on a repo: go, no or ask on each issue, merge or send back on each PR.",
  "type": "module",
  "bin": {
    "entail": "dist/cli.js"
  },
  "files": [
    "dist",
    "cases",
    "examples"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config board/vite.config.ts --logLevel warn",
    "typecheck": "tsc -p tsconfig.json && tsc -p board/tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\" && vitest run --config board/vite.config.ts",
    "board:dev": "vite --config board/vite.config.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
