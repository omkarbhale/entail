{
  "name": "entail",
  "version": "0.0.0",
  "description": "The owner's stand-in for product decisions on a repo: go, no or ask on each issue, merge or send back on each PR.",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
