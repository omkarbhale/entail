{
  "name": "entail",
  "version": "0.0.0",
  "description": "Keeps a product's vision of record and decides which decisions need its owner.",
  "type": "module",
  "bin": {
    "entail": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "acceptance:harness": "node test/acceptance/harness.ts",
    "acceptance": "node test/acceptance/acceptance.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
